{
  "manifest_version": 3,
  "name": "Webflow Input Enhancer",
  "version": "0.2",
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "description": "Improve the inline css visualization inside webflow input field.",
  "permissions": [],
  "host_permissions": [
    "*://*.design.webflow.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.design.webflow.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_start"
    }
  ]
}