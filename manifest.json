{
  "manifest_version": 3,
  "name": "Webflow Input Enhancer",
  "version": "0.4.6",
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "description": "Transform the Way You Work with Component in Webflow!",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Webflow Input Enhancer"
  },
  "permissions": ["storage"],
  "host_permissions": ["*://*.design.webflow.com/*", "*://*.preview.webflow.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.design.webflow.com/*", "*://*.preview.webflow.com/*"],
      "js": ["src/content.ts"],
      "run_at": "document_start"
    }
  ]
}
