{
  "manifest_version": 3,
  "name": "Webflow Input Enhancer",
  "version": "0.2.1",
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "description": "Improve the inline css visualization inside webflow input field.",
  "permissions": [],
  "host_permissions": [
    "*://*.design.webflow.com/*"
  ],
  "content_scripts": [
    {
      "js": [
        "assets/content.ts-loader-C3sulEe_.js"
      ],
      "matches": [
        "*://*.design.webflow.com/*"
      ],
      "run_at": "document_start",
      "css": [
        "assets/content-BHH8rdGj.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://*.design.webflow.com/*"
      ],
      "resources": [
        "assets/content.ts-BMP8DvHh.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
