{
  "manifest_version": 3,
  "name": "Webflow Input Enhancer",
  "version": "0.4.2",
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "description": "Transform the Way You Work with Component in Webflow!",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.design.webflow.com/*",
    "*://*.preview.webflow.com/*"
  ],
  "content_scripts": [
    {
      "js": [
        "assets/content.ts-loader-1To0epbV.js"
      ],
      "matches": [
        "*://*.design.webflow.com/*",
        "*://*.preview.webflow.com/*"
      ],
      "run_at": "document_start",
      "css": [
        "assets/content-Bxa5laQs.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://*.design.webflow.com/*",
        "*://*.preview.webflow.com/*"
      ],
      "resources": [
        "assets/content.ts-D3fAqF51.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
